      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/fan", "id": "F40100052FA0000100C10001", "type": "compiled.mach-o.executable", "index": false, "target-membership": [ "FanControl/copy/Copy CLI" ] },
        { "path": "<PRODUCTS>/FanControl.app", "id": "F3A812002F2180AA00D96952", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/FanControlHelper", "id": "F3B0001A2F5A000100000001", "type": "compiled.mach-o.executable", "index": false, "target-membership": [ "FanControl/copy/Copy Helper" ] },
        { "path": "<PRODUCTS>/iOS.app", "id": "F42000042FC0000100D00001", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/visionOS.app", "id": "F3F79A653063C9A5009F31C9", "type": "wrapper.application", "index": false },
