  "targets": [
    {
      "name": "FanControl",
      "id": "F3A811FF2F2180AA00D96952",
      "product": "Products/FanControl.app",
      "product-type": "application",
      "dependencies": [
        "fan",
        "FanControlHelper",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Copy CLI",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/MacOS",
        }, {
          "kind": "copy",
          "name": "Copy Helper",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Library/PrivilegedHelperTools",
        }, {
          "kind": "script",
          "name": "Embed iSMC",
          "log-environment-variables": true,
          "input-paths": [
            "$(PROJECT_DIR)/Vendor/iSMC/iSMC",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/iSMC",
            "$(TARGET_BUILD_DIR)/$(CONTENTS_FOLDER_PATH)/Library/PrivilegedHelperTools/iSMC",
          ],
          "shell": "/bin/sh",
          "script": [
            "#!/bin/bash",
            "set -euo pipefail",
            "",
            "ismc_source_binary=\"$PROJECT_DIR/Vendor/iSMC/iSMC\"",
            "ismc_resource_binary=\"$TARGET_BUILD_DIR/$UNLOCALIZED_RESOURCES_FOLDER_PATH/iSMC\"",
            "ismc_helper_binary=\"$TARGET_BUILD_DIR/$CONTENTS_FOLDER_PATH/Library/PrivilegedHelperTools/iSMC\"",
            "",
            "if [ ! -x \"$ismc_source_binary\" ]; then",
            "echo \"error: Missing vendored iSMC executable at $ismc_source_binary\"",
            "exit 1",
            "fi",
            "",
            "mkdir -p \"$(dirname \"$ismc_resource_binary\")\"",
            "cp \"$ismc_source_binary\" \"$ismc_resource_binary\"",
            "chmod 755 \"$ismc_resource_binary\"",
            "",
            "mkdir -p \"$(dirname \"$ismc_helper_binary\")\"",
            "cp \"$ismc_source_binary\" \"$ismc_helper_binary\"",
            "chmod 755 \"$ismc_helper_binary\"",
            "",
          ],
        }, {
          "kind": "copy",
          "name": "Copy LaunchDaemons",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Library/LaunchDaemons",
        },
      ],
      "package-product-members": [
        {
          "package": "AutoUpdate",
          "product-name": "AutoUpdate",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "CoreSMC",
          "product-name": "CoreSMC",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "CoreSMC",
          "product-name": "CoreSMC",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "CoreSMC",
          "product-name": "CoreSMC",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "LaunchAtLogin",
          "product-name": "LaunchAtLogin",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "ScrechKit",
          "product-name": "ScrechKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "AUTOMATION_APPLE_EVENTS": "NO",
        "CODE_SIGN_ENTITLEMENTS": "FanControl/FanControl.entitlements",
        "CODE_SIGN_IDENTITY[sdk=macosx*]": "Apple Development",
