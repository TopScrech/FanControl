{
  "sourceLanguage": "en",
  "strings": {
    " (%@)": {
      "comment": "A picker option in the settings view, allowing the user to select their preferred temperature unit. The argument is the name of the temperature unit, and the second argument is its symbol.",
      "isCommentAutoGenerated": true,
      "shouldTranslate": false
    },
    " %lld": {
      "comment": "A label for a fan, including its user-facing ID. The argument is the user-facing ID of the fan.",
      "isCommentAutoGenerated": true,
      "shouldTranslate": false
    },
    "%@ %@": {
      "comment": "A pickable option in the \"Language\" section of the settings view, showing both the flag emoji and the human-readable name of the language.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      },
      "shouldTranslate": false
    },
