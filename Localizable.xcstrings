    "FanControl is running from Downloads. Move it to /Applications and replace the existing copy so the helper can install correctly" : {
      "comment" : "An explanation shown when the app is launched from Downloads and an existing copy in Applications should be replaced.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanControl wird aus Downloads ausgeführt. Verschieben Sie es nach /Applications und ersetzen Sie die vorhandene Kopie, damit der Helper korrekt installiert werden kann"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanControl kører fra Downloads. Flyt det til /Applications, og erstat den eksisterende kopi, så hjælperen kan installeres korrekt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanControl est lancé depuis Téléchargements. Déplacez-le vers /Applications et remplacez la copie existante pour que l’utilitaire puisse s’installer correctement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanControl è in esecuzione da Download. Spostalo in /Applications e sostituisci la copia esistente affinché l’helper possa installarsi correttamente"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanControl se está ejecutando desde Descargas. Muévelo a /Applications y reemplaza la copia existente para que el asistente pueda instalarse correctamente"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanControl draait vanuit Downloads. Verplaats het naar /Applications en vervang de bestaande kopie zodat de helper correct kan worden geïnstalleerd"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanControl запущен из Downloads. Переместите его в /Applications и замените существующую копию, чтобы helper мог установиться корректно"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanControl İndirilenler klasöründen çalışıyor. Yardımcının doğru yüklenmesi için onu /Applications klasörüne taşıyın ve mevcut kopyayı değiştirin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanControl запущено з Downloads. Перемістіть його до /Applications і замініть наявну копію, щоб helper міг правильно встановитися"
          }
        }
      }
    },
