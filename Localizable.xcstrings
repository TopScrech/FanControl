    "This removes the saved email and license key from this Mac and unregisters this device" : {
      "comment" : "A message displayed in a confirmation dialog when resetting a license.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner den gemte e-mail og licensnøgle fra denne Mac og afregistrerer denne enhed"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die gespeicherte E-Mail und der Lizenzschlüssel von diesem Mac entfernt und dieses Gerät abgemeldet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina el correo electrónico y la clave de licencia guardados de este Mac y anula el registro de este dispositivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime l’e-mail et la clé de licence enregistrés de ce Mac et désenregistre cet appareil"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह इस Mac से सहेजा गया ईमेल और लाइसेंस कुंजी हटाता है और इस डिवाइस का पंजीकरण समाप्त करता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo rimuove l’e-mail e la chiave di licenza salvate da questo Mac e annulla la registrazione di questo dispositivo"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verwijdert het opgeslagen e-mailadres en de licentiesleutel van deze Mac en deregistreert dit apparaat"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит сохранённые адрес электронной почты и лицензионный ключ с этого Mac и отменит регистрацию этого устройства"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem kaydedilmiş e-postayı ve lisans anahtarını bu Mac’ten kaldırır ve bu aygıtın kaydını siler"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це видалить збережені адресу електронної пошти й ліцензійний ключ з цього Mac та скасує реєстрацію цього пристрою"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从这台 Mac 中移除已保存的邮箱和许可证密钥，并注销此设备"
          }
        }
      }
    },
